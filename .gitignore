# Scratch certificates from local onomancer runs…
**/*.onc
# …but checked-in test fixtures are deliberate
!**/tests/fixtures/*.onc

# Generated by Cargo
/target
debug

# Backup files generated by rustfmt
**/*.rs.bk

# Generated by cargo mutants
**/mutants.out*/

# Wasm / JS build artifacts
**/dist/
**/node_modules/
**/.pnpm-store/
**/pkg/
**/pkg-node/

# Nix
.direnv/
result

# Session artifacts
.ignore/
.pi-subagents/
